<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ডিজিটাল ভূমি দলিল সেবা | Digital Land Deed Service</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;700&family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="gov-page">

  <div class="gov-topbar">
    <span class="gov-topbar-text">
      <span class="lang-bn">ডিজিটাল ভূমি সেবা উদ্যোগ — একাডেমিক প্রোটোটাইপ</span>
      <span class="lang-en">Digital Land Service Initiative — Academic Prototype</span>
    </span>
    <button id="langToggle" class="lang-switch" type="button">English</button>
  </div>

  <header class="gov-header">
    <div class="gov-brand">
      <span class="gov-badge" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="10" y="6" width="28" height="36" rx="2"/>
          <path d="M16 16h16M16 23h16M16 30h10"/>
          <path d="M18 36l4 4 8-9" stroke="#e2231a" stroke-width="2.6"/>
        </svg>
      </span>
      <div class="gov-brand-text">
        <span class="gov-title">
          <span class="lang-bn">দলিল যাচাই সেবা</span>
          <span class="lang-en">DeedVerify Service</span>
        </span>
        <span class="gov-subtitle">
          <span class="lang-bn">ভূমি ব্যবস্থাপনা সংশ্লিষ্ট ডিজিটাল উদ্যোগ</span>
          <span class="lang-en">A land-administration-aligned digital initiative</span>
        </span>
      </div>
    </div>
  </header>

  <section class="gov-hero">
    <h1>
      <span class="lang-bn">আপনার জমির দলিল যাচাই করুন নিমিষেই</span>
      <span class="lang-en">Verify Your Land Deed in Seconds</span>
    </h1>
    <p class="hero-sub">
      <span class="lang-bn">হ্যাশিং, ডিজিটাল স্বাক্ষর ও কিউআর কোডের মাধ্যমে জাল বা পরিবর্তিত দলিল সঙ্গে সঙ্গে শনাক্ত করা হয়।</span>
      <span class="lang-en">Hashing, digital signatures, and QR codes detect a forged or altered deed instantly.</span>
    </p>
    <div class="hero-actions">
      <a href="/register" class="btn-primary">
        <span class="lang-bn">দলিল নিবন্ধন করুন</span>
        <span class="lang-en">Register a Deed</span>
      </a>
      <a href="/verify" class="btn-secondary">
        <span class="lang-bn">দলিল যাচাই করুন</span>
        <span class="lang-en">Verify a Deed</span>
      </a>
    </div>
  </section>

  <section class="gov-services">
    <h2>
      <span class="lang-bn">আমাদের সেবাসমূহ</span>
      <span class="lang-en">Our Services</span>
    </h2>
    <div class="service-grid">

      <a href="/register" class="service-card">
        <svg class="service-icon" viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="9" y="6" width="30" height="36" rx="2"/>
          <path d="M16 16h16M16 24h16M16 32h9"/>
        </svg>
        <span class="service-name">
          <span class="lang-bn">দলিল নিবন্ধন</span>
          <span class="lang-en">Register a Deed</span>
        </span>
        <span class="service-desc">
          <span class="lang-bn">নতুন দলিল হ্যাশ, স্বাক্ষর ও কিউআর কোডসহ নিবন্ধন করুন</span>
          <span class="lang-en">Register a new deed with hash, signature, and QR code</span>
        </span>
      </a>

      <a href="/verify" class="service-card">
        <svg class="service-icon" viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M24 6l14 5v11c0 10-6 17-14 20-8-3-14-10-14-20V11z"/>
          <path d="M18 24l4 4 8-9"/>
        </svg>
        <span class="service-name">
          <span class="lang-bn">দলিল যাচাই</span>
          <span class="lang-en">Verify a Deed</span>
        </span>
        <span class="service-desc">
          <span class="lang-bn">দলিল আইডি দিয়ে তাৎক্ষণিকভাবে সত্যতা যাচাই করুন</span>
          <span class="lang-en">Instantly confirm a deed's authenticity by its ID</span>
        </span>
      </a>

      <div class="service-card is-disabled">
        <span class="coming-soon">
          <span class="lang-bn">শীঘ্রই আসছে</span>
          <span class="lang-en">Coming soon</span>
        </span>
        <svg class="service-icon" viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M8 24a16 16 0 0 1 27-11M40 24a16 16 0 0 1-27 11"/>
          <path d="M35 8v6h-6M13 40v-6h6"/>
        </svg>
        <span class="service-name">
          <span class="lang-bn">ই-নামজারি সংযোগ</span>
          <span class="lang-en">e-Mutation Link</span>
        </span>
        <span class="service-desc">
          <span class="lang-bn">নিবন্ধনের পর স্বয়ংক্রিয়ভাবে নামজারি প্রক্রিয়া শুরু</span>
          <span class="lang-en">Automatically trigger mutation after registration</span>
        </span>
      </div>

      <div class="service-card is-disabled">
        <span class="coming-soon">
          <span class="lang-bn">শীঘ্রই আসছে</span>
          <span class="lang-en">Coming soon</span>
        </span>
        <svg class="service-icon" viewBox="0 0 48 48" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="24" cy="24" r="16"/>
          <path d="M24 14v10l7 5"/>
        </svg>
        <span class="service-name">
          <span class="lang-bn">মালিকানার ইতিহাস</span>
          <span class="lang-en">Ownership History</span>
        </span>
        <span class="service-desc">
          <span class="lang-bn">একটি নির্দিষ্ট জমির সম্পূর্ণ মালিকানা পরিবর্তনের ইতিহাস দেখুন</span>
          <span class="lang-en">View a parcel's full ownership change history</span>
        </span>
      </div>

    </div>
  </section>

  <section class="gov-notice">
    <h2>
      <span class="lang-bn">নোটিশ বোর্ড</span>
      <span class="lang-en">Notice Board</span>
    </h2>
    <ul class="notice-list">
      <li>
        <span class="lang-bn">দলিল নিবন্ধন ও যাচাই সেবা চালু হয়েছে।</span>
        <span class="lang-en">Deed registration and verification service is now live.</span>
      </li>
      <li>
        <span class="lang-bn">নিরাপত্তা হালনাগাদ: হ্যাশ-চেইন ভিত্তিক যাচাইকরণ সক্রিয় করা হয়েছে।</span>
        <span class="lang-en">Security update: hash-chain-based verification is active.</span>
      </li>
      <li>
        <span class="lang-bn">এই প্ল্যাটফর্মটি বর্তমানে একটি পাইলট/প্রোটোটাইপ সংস্করণ।</span>
        <span class="lang-en">This platform is currently a pilot/prototype version.</span>
      </li>
    </ul>
  </section>

  <footer class="gov-footer">
    <p class="gov-footer-event">LandTech 2026 Innovation Hackathon · Daffodil International University</p>
    <p class="gov-footer-sub">
      <span class="lang-bn">© ২০২৬ — একাডেমিক প্রোটোটাইপ প্রকল্প। সর্বস্বত্ব সংরক্ষিত।</span>
      <span class="lang-en">© 2026 — Academic prototype project. All rights reserved.</span>
    </p>
  </footer>

  <script>
    const langToggle = document.getElementById('langToggle');
    langToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const nowEnglish = html.classList.toggle('lang-mode-en');
      html.lang = nowEnglish ? 'en' : 'bn';
      langToggle.textContent = nowEnglish ? 'বাংলা' : 'English';
    });
  </script>
</body>
</html>